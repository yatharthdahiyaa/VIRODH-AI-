{
  "name": "virodh-dashboard-server",
  "version": "1.0.0",
  "private": true,
  "description": "Virodh AI dashboard backend: accounts, sessions, roles, per-user API keys; serves the React app and proxies to the Python inspection engine.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write src test eslint.config.js",
    "format:check": "prettier --check src test eslint.config.js"
  },
  "dependencies": {
    "express": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
